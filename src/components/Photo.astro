---
/**
 * Emplacement photo.
 * Tant que le fichier src/assets/photos/<nom>.(jpg|jpeg|png|webp) n'existe pas,
 * affiche l'encart beige #D6CDBE avec la description. Dès que le fichier est déposé,
 * la photo s'affiche (convertie en WebP par Astro, chargement différé).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  nom: string;
  alt: string;
  tag?: string;
  style?: string;
  class?: string;
  eager?: boolean;
  largeur?: number;
}
const { nom, alt, tag, style, class: cls, eager = false, largeur = 1200 } = Astro.props;
const fichiers = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const trouve = Object.entries(fichiers).find(([p]) => p.replace(/^.*\//, '').replace(/\.\w+$/, '') === nom);
const src = trouve?.[1].default;
---
{src ? (
  <div class:list={['ph', 'ph--photo', cls]} style={style}>
    <Image src={src} alt={alt} widths={[480, 800, largeur, largeur * 2].filter((w) => w <= src.width)} sizes={`(max-width: 960px) 100vw, ${largeur}px`} loading={eager ? 'eager' : 'lazy'} format="webp" />
  </div>
) : (
  <div class:list={['ph', cls]} style={style} role="img" aria-label={alt} data-photo={nom}>
    {tag && <span class="tag">{tag}</span>}
  </div>
)}
