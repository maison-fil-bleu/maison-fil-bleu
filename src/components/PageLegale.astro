---
/** Gabarit des pages légales : textes à fournir par le fondateur (PASSATION.md § 11-12). */
import Famille from '../layouts/Famille.astro';
interface Props { titre: string; title: string; description: string }
const { titre, title, description } = Astro.props;
---
<Famille title={title} description={description}>
  <section class="sec">
    <div class="w" style="max-width:860px;display:flex;flex-direction:column;gap:28px">
      <span class="lbl">Informations légales</span>
      <h1 class="h1">{titre}</h1>
      <div class="legal"><slot /></div>
    </div>
  </section>
</Famille>
<style>
  .legal :global(p){font-size:17px;line-height:1.85;color:#3E434C;margin:0 0 18px}
  .legal :global(h2){font-family:var(--serif);font-weight:500;font-size:32px;color:var(--nuit);margin:40px 0 14px}
  .legal :global(h3){font-family:var(--sans,'Nunito Sans',sans-serif);font-weight:600;font-size:17px;color:var(--nuit);margin:26px 0 8px}
  .legal :global(ul){margin:0 0 18px;padding-left:22px}
  .legal :global(li){font-size:17px;line-height:1.75;color:#3E434C;margin-bottom:8px}
  .legal :global(.version){font-size:14px;color:#5B606A;font-style:italic}
  .legal :global(.table){overflow-x:auto;margin:0 0 22px}
  .legal :global(table){border-collapse:collapse;width:100%;min-width:620px;font-size:15px;line-height:1.5;color:#3E434C}
  .legal :global(th),.legal :global(td){border-bottom:1px solid #DDD4C5;padding:12px 10px;text-align:left;vertical-align:top}
  .legal :global(th){font-weight:600;color:var(--nuit);background:#F7F1E7}
</style>
