---
/**
 * Conditions générales : particuliers (Maison Fil Bleu) puis professionnels (Fil Bleu Pro).
 * Texte dans src/config/cgv.ts (export juridique du 17/11/2026), partagé avec le devis PDF de l'appli.
 * À faire relire avant la mise en ligne. Crochets à compléter.
 */
import PageLegale from '../components/PageLegale.astro';
import { CGV_PARTICULIERS, CGV_PRO, texte } from '../config/cgv';
const sections = [
  { id: 'particuliers', titre: 'Conditions générales de vente · particuliers', version: true, articles: CGV_PARTICULIERS },
  { id: 'professionnels', titre: 'Conditions générales · professionnels (Fil Bleu Pro)', version: false, articles: CGV_PRO },
];
---
<PageLegale titre="Conditions générales de vente" title="Conditions générales de vente | Maison Fil Bleu Marseille" description="Conditions générales de vente des prestations Maison Fil Bleu (particuliers) et Fil Bleu Pro (professionnels) à Marseille et en région PACA.">
  <p><a href="#particuliers">Particuliers (Maison Fil Bleu)</a> · <a href="#professionnels">Professionnels (Fil Bleu Pro)</a></p>
  {sections.map((s) => (
    <>
      <h2 id={s.id}>{s.titre}</h2>
      {s.version && <p class="version">Version du [date].</p>}
      {s.articles.map((a) => (
        <>
          <h3>{a.titre}</h3>
          {a.blocs.map((b) => ('p' in b
            ? <p>{texte(b.p).replace(/^Voir notre politique de confidentialité\.$/, '')}{/^Voir notre politique/.test(b.p) && <>Voir notre <a href="/confidentialite">politique de confidentialité</a>.</>}</p>
            : <ul>{b.ul.map((li) => <li>{texte(li)}</li>)}</ul>))}
        </>
      ))}
    </>
  ))}
</PageLegale>
