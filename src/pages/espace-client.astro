---
/**
 * Espace client : la personne accompagnée et ses proches suivent leur dossier
 * (étapes, photos partagées, documents). Connexion par lien envoyé par e-mail.
 * Page non indexée ; les données ne sont chargées qu'après connexion (règles d'accès Supabase).
 */
import Famille from '../layouts/Famille.astro';
import { SITE, lienTel } from '../config/site';
const tel = lienTel(SITE.telephone);
---
<Famille title="Espace client | Maison Fil Bleu" description="Suivez votre dossier Maison Fil Bleu : étapes, photos et documents, avec vos proches." noindex>
  <section class="ec">
    <div class="w ec-w">
      <span class="lbl">Espace client</span>
      <div id="ec-app" aria-live="polite">
        <noscript><p class="p">Votre espace client a besoin de JavaScript pour s'afficher.</p></noscript>
        <p class="p ec-charge">Chargement de votre espace…</p>
      </div>
    </div>
  </section>
  <script is:inline define:vars={{ telephone: SITE.telephone, lienTelephone: tel }}>
    window.__FB_CONTACT = { telephone, lienTelephone };
  </script>
</Famille>

<script>
  import '../espace/espace.js';
</script>

<style is:global>
  .ec{padding:72px 0 112px;background:var(--ivoire)}
  .ec-w{max-width:760px;display:flex;flex-direction:column;gap:22px}
  .ec h1{font-family:var(--serif);font-weight:500;font-size:46px;line-height:1.08;color:var(--nuit);margin:0}
  .ec h2{font-family:var(--serif);font-weight:500;font-size:28px;line-height:1.15;color:var(--nuit);margin:0}
  .ec-carte{background:#fff;border:1px solid var(--filet-2);padding:32px;display:flex;flex-direction:column;gap:16px}
  .ec-carte.sable{background:var(--sable);border-color:transparent}
  .ec label{display:flex;flex-direction:column;gap:8px;font-size:14px;color:var(--gris)}
  .ec input[type=email]{font:inherit;font-size:17px;color:var(--encre);background:var(--ivoire);border:1px solid var(--filet);padding:15px 16px;width:100%}
  .ec input:focus-visible,.ec button:focus-visible,.ec a:focus-visible,.ec select:focus-visible{outline:2px solid var(--bleu);outline-offset:2px}
  .ec .btn{align-self:flex-start;border:0;cursor:pointer}
  .ec-msg{font-size:15px;line-height:1.6;padding:14px 16px;background:var(--sable);border-left:3px solid var(--bleu);color:var(--encre)}
  .ec-msg.alerte{border-left-color:#A23B3B}
  .ec-entete{display:flex;flex-direction:column;gap:6px}
  .ec-meta{font-size:15px;color:var(--gris)}
  .ec-choix{display:flex;flex-wrap:wrap;gap:8px}
  .ec-choix button{font:inherit;font-size:14px;padding:10px 16px;border:1px solid var(--filet);background:#fff;color:var(--encre);cursor:pointer}
  .ec-choix button[aria-pressed=true]{background:var(--nuit);border-color:var(--nuit);color:#fff}
  /* Frise des étapes */
  .ec-frise{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
  .ec-frise li{position:relative;padding:0 0 26px 40px}
  .ec-frise li:last-child{padding-bottom:0}
  .ec-frise li::before{content:'';position:absolute;left:11px;top:26px;bottom:0;width:2px;background:var(--filet-2)}
  .ec-frise li:last-child::before{display:none}
  .ec-point{position:absolute;left:0;top:2px;width:24px;height:24px;border-radius:50%;border:2px solid var(--filet);background:#fff;display:flex;align-items:center;justify-content:center}
  .ec-frise li.termine .ec-point{background:var(--bleu);border-color:var(--bleu)}
  .ec-frise li.termine .ec-point::after{content:'';width:9px;height:5px;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:rotate(-45deg) translate(1px,-1px)}
  .ec-frise li.en_cours .ec-point{border-color:var(--laiton)}
  .ec-frise li.en_cours .ec-point::after{content:'';width:10px;height:10px;border-radius:50%;background:var(--laiton)}
  .ec-frise li.termine::before{background:var(--bleu)}
  .ec-etape{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px}
  .ec-etape b{font-family:var(--serif);font-size:22px;font-weight:600;color:var(--nuit)}
  .ec-etat{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--gris)}
  .ec-frise li.en_cours .ec-etat{color:var(--laiton-texte)}
  .ec-frise li.termine .ec-etat{color:var(--bleu)}
  .ec-date{font-size:14px;color:var(--gris)}
  .ec-texte{margin:8px 0 0;font-size:16px;line-height:1.7;color:var(--encre);white-space:pre-line}
  /* Photos et documents */
  .ec-galerie{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px}
  .ec-galerie a{display:block;aspect-ratio:4/3;background:var(--photo);overflow:hidden}
  .ec-galerie img{width:100%;height:100%;object-fit:cover;display:block}
  .ec-docs{list-style:none;margin:0;padding:0}
  .ec-docs li{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid var(--sable)}
  .ec-docs li:last-child{border-bottom:0}
  .ec-docs span{font-size:13px;color:var(--gris)}
  .ec-lien{font:inherit;font-size:14px;font-weight:500;color:var(--bleu);background:none;border:0;padding:6px 0;cursor:pointer;text-decoration:underline;text-underline-offset:3px;white-space:nowrap}
  .ec-contact{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
  .ec-bas{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:14px;color:var(--gris)}
  @media (max-width:960px){
    .ec{padding:48px 0 80px}
    .ec h1{font-size:36px}
    .ec-carte{padding:22px}
  }
</style>
