---
/**
 * Espace client : la famille suit son dossier (avancement détaillé, journal, décisions, logement,
 * objets conservés, documents, photos). Connexion par code reçu par e-mail.
 * Page non indexée ; les données ne sont chargées qu'après connexion (règles d'accès Supabase).
 */
import Famille from '../layouts/Famille.astro';
import { getImage } from 'astro:assets';
import fond from '../assets/photos/succession-haut.jpg';
import { SITE, lienTel } from '../config/site';
const tel = lienTel(SITE.telephone);
const photoFond = (await getImage({ src: fond, width: 1800, format: 'webp' })).src;
---
<Famille title="Espace client | Maison Fil Bleu" description="Suivez votre dossier Maison Fil Bleu : avancement, journal, décisions, photos et documents, avec vos proches." noindex>
  <div id="ec-app" aria-live="polite">
    <noscript><div class="w" style="padding:80px 0"><p class="p">Votre espace client a besoin de JavaScript pour s'afficher.</p></div></noscript>
    <div class="w ec-charge"><p class="p">Chargement de votre espace…</p></div>
  </div>
  <script is:inline define:vars={{ telephone: SITE.telephone, lienTelephone: tel, photoFond }}>
    window.__FB_CONTACT = { telephone, lienTelephone, photoFond };
  </script>
</Famille>

<script>
  import '../espace/espace.js';
</script>

<style is:global>
  /* Place réservée pendant le chargement : la page ne « saute » pas quand l'espace s'affiche. */
  #ec-app{min-height:720px;background:var(--ivoire)}
  .ec-charge{padding:120px 0}
  .ec-apercu{background:var(--nuit);color:#fff;font-size:14.5px;line-height:1.5;padding:12px 0;border-bottom:3px solid var(--laiton)}

  /* Écrans simples (connexion, code, espace pas encore ouvert) : photo en fond, carte au centre. */
  .ec-simple-in{padding-top:96px;padding-bottom:120px}
  .ec-w{max-width:620px;display:flex;flex-direction:column;gap:22px}
  .ec-simple h1{font-family:var(--serif);font-weight:500;font-size:52px;line-height:1.06;color:var(--nuit);margin:0}
  .ec-carte{background:#fff;border:1px solid var(--filet-2);padding:32px;display:flex;flex-direction:column;gap:16px;box-shadow:0 24px 50px rgba(21,35,58,.10)}
  #ec-app label{display:flex;flex-direction:column;gap:8px;font-size:14px;color:var(--gris)}
  #ec-app input[type=email],#ec-app input[type=text]{font:inherit;font-size:17px;color:var(--encre);background:var(--ivoire);border:1px solid var(--filet);padding:14px 16px;width:100%}
  #ec-app input:focus-visible,#ec-app button:focus-visible,#ec-app a:focus-visible,#ec-app summary:focus-visible{outline:2px solid var(--bleu);outline-offset:2px}
  .ec-carte .btn,.ec-bon .btn,.ecx-signer .btn{align-self:flex-start;border:0;cursor:pointer}
  .ec-code{font-size:28px!important;letter-spacing:10px;text-align:center;font-variant-numeric:tabular-nums;max-width:260px}
  .ec-msg{font-size:15px;line-height:1.6;padding:14px 16px;background:var(--sable);border-left:3px solid var(--bleu);color:var(--encre)}
  .ec-msg.alerte{border-left-color:#A23B3B}
  .ec-lien{font:inherit;font-size:14px;font-weight:600;color:var(--bleu);background:none;border:0;padding:4px 0;cursor:pointer;text-decoration:underline;text-underline-offset:3px;white-space:nowrap}
  .ec-contact{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
  .ec-choix{display:flex;flex-wrap:wrap;gap:8px}
  .ec-choix button{font:inherit;font-size:13.5px;padding:8px 14px;border:1px solid var(--filet);background:rgba(255,255,255,.85);color:var(--encre);cursor:pointer}
  .ec-choix button[aria-pressed=true]{background:var(--nuit);border-color:var(--nuit);color:#fff}

  /* Bon d'intervention à signer à distance */
  .ec-bon{border-top:3px solid var(--bleu);box-shadow:none}
  .ec-bon h2{font-family:var(--serif);font-weight:500;font-size:28px;color:var(--nuit);margin:0}
  .ec-bon-bloc{display:flex;flex-direction:column;gap:4px;font-size:15px;line-height:1.55}
  .ec-bon-bloc p,.ec-bon-bloc ul{margin:0}.ec-bon-bloc ul{padding-left:20px}
  .ec-bon-lbl{font-size:14px;font-weight:600}
  .ec-pad{width:100%;height:200px;background:#fff;border:1px dashed var(--filet);touch-action:none;display:block}

  /* Tableau de bord */

  .ecx-hero{position:relative;display:grid;grid-template-columns:1fr 360px;gap:56px;align-items:end;padding-top:120px;padding-bottom:96px}
  .ecx-hero-txt{display:flex;flex-direction:column;gap:20px;max-width:640px}
  .ecx-hero .h1{color:var(--nuit);margin:0}
  .ecx-hero .lead{color:#4A4F58;margin:0}
  .ecx-prog{display:flex;flex-direction:column;gap:10px;font-size:14px;color:var(--gris);max-width:420px}
  .ecx-prog-barre{height:4px;background:rgba(21,35,58,.12)}
  .ecx-prog-barre span{display:block;height:100%;background:var(--laiton)}
  .ecx-next{background:rgba(255,255,255,.96);border-top:3px solid var(--laiton);padding:30px;display:flex;flex-direction:column;gap:12px;box-shadow:0 24px 50px rgba(21,35,58,.14)}
  .ecx-next-lbl{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--laiton-texte)}
  .ecx-next-date{display:flex;align-items:center;gap:14px;font-family:var(--serif);color:var(--nuit)}
  .ecx-next-date b{font-size:64px;font-weight:500;line-height:1}
  .ecx-next-date span{font-size:20px;line-height:1.15}
  .ecx-next-t{font-family:var(--serif);font-size:24px;color:var(--nuit);margin:0}
  .ecx-next-d{font-size:14.5px;line-height:1.6;color:var(--gris);margin:0}
  .ecx-next-l{font-size:14px;font-weight:600;color:var(--bleu);text-decoration:none}

  .ecx-nav{position:sticky;top:0;z-index:15;background:rgba(248,245,239,.96);backdrop-filter:blur(6px);border-bottom:1px solid var(--filet-3)}
  .ecx-nav-in{display:flex;gap:34px;overflow-x:auto;scrollbar-width:none}
  .ecx-nav a{display:flex;align-items:center;gap:8px;padding:18px 0;font-size:12.5px;font-weight:600;letter-spacing:1.4px;text-transform:uppercase;color:var(--encre);text-decoration:none;white-space:nowrap;border-bottom:2px solid transparent}
  .ecx-nav a:hover{border-bottom-color:var(--laiton)}
  .ecx-pastille{background:var(--laiton);color:#fff;font-size:11px;letter-spacing:0;min-width:20px;height:20px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center}

  .ecx{background:var(--ivoire);padding:56px 0 110px}
  .ecx-w{display:flex;flex-direction:column;gap:88px}
  .ecx-sec{display:flex;flex-direction:column;gap:32px;scroll-margin-top:80px}
  .ecx-sec-h{display:flex;flex-direction:column;gap:12px;max-width:720px}
  .ecx-sec-h .h2,.ecx-sec-h .h3{margin:0;color:var(--nuit)}
  .ecx-sec-h .p{margin:0}


  .ecx-frise{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,1fr);position:relative}
  .ecx-frise::before{content:'';position:absolute;top:21px;left:10%;right:10%;height:2px;background:var(--filet-2)}
  .ecx-frise li{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;padding:0 8px}
  .ecx-rond{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:20px;background:var(--ivoire);border:2px solid var(--filet);color:var(--gris);position:relative;margin-bottom:8px}
  .ecx-frise .termine .ecx-rond{background:var(--nuit);border-color:var(--nuit);color:#fff}
  .ecx-frise .en_cours .ecx-rond{background:#fff;border-color:var(--laiton);color:var(--laiton);box-shadow:0 0 0 6px rgba(138,109,67,.14)}
  .ecx-frise b{font-family:var(--serif);font-size:21px;font-weight:600;color:var(--nuit)}
  .ecx-frise li>span:last-child{font-size:13.5px;color:var(--gris)}
  .ecx-frise .en_cours li>span:last-child,.ecx-frise .en_cours>span:last-child{color:var(--laiton-texte);font-weight:600}

  .ecx-journal{background:#fff;border:1px solid var(--filet-2);padding:32px 36px;display:flex;flex-direction:column;gap:0}
  .ecx-journal h3{font-family:var(--serif);font-weight:500;font-size:24px;color:var(--nuit);margin:0 0 10px}
  .ecx-msg{display:flex;gap:16px;padding:20px 0;border-top:1px solid var(--sable)}
  .ecx-msg:first-of-type{border-top:0}
  .ecx-avatar{width:42px;height:42px;flex:none;border-radius:50%;background:var(--nuit);color:#fff;font-size:13px;font-weight:600;letter-spacing:1px;display:flex;align-items:center;justify-content:center}
  .ecx-avatar.clair{background:var(--sable);color:var(--nuit)}
  .ecx-msg-h{display:flex;gap:12px;align-items:baseline;flex-wrap:wrap}
  .ecx-msg-h b{font-size:15px;color:var(--nuit)}
  .ecx-msg-h time{font-size:13px;color:var(--gris)}
  .ecx-msg p{margin:6px 0 0;font-size:15.5px;line-height:1.65;color:var(--encre)}


  .ecx-avap{position:relative;height:520px;overflow:hidden;--pos:50%;user-select:none}
  .ecx-avap .ph{position:absolute;inset:0;height:100%;margin:0}
  .ecx-avap img{width:100%;height:100%;object-fit:cover}
  .ecx-avap-avant{position:absolute;inset:0;clip-path:inset(0 calc(100% - var(--pos)) 0 0)}
  .ecx-avap input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
  .ecx-avap-ligne{position:absolute;top:0;bottom:0;left:var(--pos);width:2px;background:#fff;pointer-events:none;transform:translateX(-1px)}
  .ecx-avap-ligne::after{content:'⟷';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:46px;height:46px;border-radius:50%;background:#fff;color:var(--nuit);display:flex;align-items:center;justify-content:center;font-size:18px;box-shadow:0 6px 18px rgba(0,0,0,.2)}
  .ecx-avap-tag{position:absolute;top:18px;background:rgba(21,35,58,.82);color:#fff;font-size:11.5px;font-weight:600;letter-spacing:1.6px;text-transform:uppercase;padding:6px 12px;pointer-events:none}
  .ecx-avap-tag.g{left:18px}.ecx-avap-tag.d{right:18px}
  .ecx-legende{font-size:14px;color:var(--gris);margin:-18px 0 0}
  .ecx-galerie{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .ecx-galerie figure{margin:0;display:flex;flex-direction:column;gap:10px}
  .ecx-galerie .ph{height:220px;margin:0}
  .ecx-galerie img{width:100%;height:100%;object-fit:cover}
  .ecx-galerie figcaption{font-size:14px;color:var(--gris)}

  .ecx-lien{font:inherit;font-size:14px;font-weight:600;color:var(--bleu);background:none;border:0;padding:0;cursor:pointer;text-decoration:underline;text-underline-offset:3px;white-space:nowrap}

  .ecx-contact{display:grid;grid-template-columns:1fr 1fr;background:var(--nuit);scroll-margin-top:80px}
  .ecx-contact-ph{height:100%;min-height:340px;margin:0}
  .ecx-contact-ph img{width:100%;height:100%;object-fit:cover}
  .ecx-contact-c{padding:52px 48px;display:flex;flex-direction:column;gap:18px;justify-content:center}
  .ecx-contact-c .h2{margin:0}
  .ecx-contact-c p{color:#C5CCD8;font-size:16px;line-height:1.65;margin:0}
  .ecx-contact-b{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px}
  .ecx-btn-clair{background:#fff!important;color:var(--nuit)!important}
  .ecx-btn-ligne{display:inline-flex;align-items:center;padding:15px 24px;border:1px solid rgba(255,255,255,.5);color:#fff;text-decoration:none;font-size:12.5px;font-weight:600;letter-spacing:1.6px;text-transform:uppercase}
  .ecx-bas{display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:14px;color:var(--gris);margin-top:-48px;flex-wrap:wrap}

  @media (max-width:960px){
    .ecx-hero{grid-template-columns:1fr;gap:32px;padding-top:72px;padding-bottom:48px}
    .ecx-w{gap:64px}
    .ecx-frise{grid-template-columns:1fr;gap:0}
    .ecx-frise::before{top:22px;bottom:22px;left:21px;right:auto;width:2px;height:auto}
    .ecx-frise li{display:grid;grid-template-columns:44px 1fr;grid-template-rows:auto auto;column-gap:16px;row-gap:0;text-align:left;align-items:center;padding:0 0 22px}
    .ecx-rond{grid-row:1 / span 2;margin:0}
    .ecx-journal{padding:24px 20px}
    .ecx-avap{height:340px}
    .ecx-galerie{grid-template-columns:1fr 1fr}
    .ecx-galerie figure:last-child{display:none}
    .ecx-duo,.ecx-contact{grid-template-columns:1fr}
    .ecx-contact-ph{min-height:220px}
    .ecx-contact-c{padding:36px 24px}
    .ecx-bas{margin-top:-32px}
  }
  /* --- Détails « logiciel métier » --- */
  .ecx-w{gap:72px}
  .ecx-kpis{display:grid;grid-template-columns:repeat(5,1fr);background:#fff;border:1px solid var(--filet-2)}
  .ecx-kpis>div{padding:20px 22px;display:flex;flex-direction:column;gap:4px;border-left:1px solid var(--filet-3)}
  .ecx-kpis>div:first-child{border-left:0}
  .ecx-kpis span{font-size:11.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--gris)}
  .ecx-kpis b{font-family:var(--serif);font-size:34px;font-weight:600;line-height:1.05;color:var(--nuit)}
  .ecx-kpis small{font-size:13px;color:var(--gris)}
  .ecx-panneau{background:#fff;border:1px solid var(--filet-2)}
  .ecx-panneau-h{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 22px;border-bottom:1px solid var(--filet-3)}
  .ecx-panneau-h h3{font-family:var(--serif);font-size:22px;font-weight:600;margin:0;color:var(--nuit)}
  .ecx-duo2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .ecx-b{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 16px;border:1px solid var(--filet);background:#fff;color:var(--nuit);font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap}
  .ecx-b:hover{border-color:var(--nuit)}
  .ecx-b.plein{background:var(--nuit);border-color:var(--nuit);color:#fff}
  .ecx-b.plein:hover{background:var(--bleu);border-color:var(--bleu)}
  .ecx-b.petit{height:30px;padding:0 12px;font-size:12px}
  .ecx-badge{display:inline-flex;align-items:center;height:23px;padding:0 9px;font-size:11.5px;font-weight:700;letter-spacing:.3px;font-style:normal;white-space:nowrap}
  .ecx-badge.ok{background:#E4EFE6;color:#2D6A3E}
  .ecx-badge.cours{background:#E3EBF5;color:#2F4F7A}
  .ecx-badge.attente{background:#F7ECD9;color:#8A5A12}
  .ecx-badge.a{background:#EEECE8;color:var(--gris)}
  .ecx-mini{font-size:12px;font-weight:700;color:var(--gris);background:var(--ivoire);padding:4px 9px;border-radius:10px;white-space:nowrap}
  .ecx-gris{color:var(--gris)}
  .ecx-actions{list-style:none;margin:0;padding:0}
  .ecx-actions li{display:flex;align-items:center;gap:16px;padding:16px 22px;border-top:1px solid var(--filet-3)}
  .ecx-actions li:first-child{border-top:0}
  .ecx-actions li>div{flex:1;display:flex;flex-direction:column;gap:3px}
  .ecx-actions b{font-size:15px;color:var(--nuit)}
  .ecx-actions span{font-size:13px;color:var(--gris)}
  .ecx-check{list-style:none;margin:0;padding:6px 22px 12px}
  .ecx-check li{display:flex;align-items:center;gap:12px;padding:9px 0;font-size:14.5px;border-top:1px dashed var(--filet-3)}
  .ecx-check li:first-child{border-top:0}
  .ecx-check li>span{margin-left:auto;font-size:13px;color:var(--gris);white-space:nowrap;padding-left:12px}
  .ecx-check i{width:19px;height:19px;flex:none;border:1.5px solid var(--filet);display:flex;align-items:center;justify-content:center}
  .ecx-check li.ok{color:var(--gris)}
  .ecx-check li.ok i{background:#2D6A3E;border-color:#2D6A3E;color:#fff}
  .ecx-check li.cours i{border-color:#2F4F7A;background:linear-gradient(90deg,#2F4F7A 50%,transparent 50%)}
  .ecx-check li.attente i{border-color:#C98A2B}
  .ecx-check li.attente{color:var(--nuit);font-weight:600}
  .ecx-phases{display:flex;flex-direction:column;gap:10px}
  .ecx-phase{background:#fff;border:1px solid var(--filet-2)}
  .ecx-phase summary{display:flex;align-items:center;gap:14px;padding:15px 22px;cursor:pointer;list-style:none}
  .ecx-phase summary::-webkit-details-marker{display:none}
  .ecx-phase[open] summary{border-bottom:1px solid var(--filet-3)}
  .ecx-num{width:30px;height:30px;flex:none;border-radius:50%;border:1.5px solid var(--filet);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:var(--gris)}
  .ecx-phase.termine .ecx-num{background:var(--nuit);border-color:var(--nuit);color:#fff}
  .ecx-phase.en_cours{border-color:var(--laiton)}
  .ecx-phase.en_cours .ecx-num{border-color:var(--laiton);color:var(--laiton)}
  .ecx-phase summary b{font-family:var(--serif);font-size:21px;font-weight:600;color:var(--nuit)}
  .ecx-quand{font-size:13.5px;color:var(--gris)}
  .ecx-phase.en_cours .ecx-quand{color:var(--laiton-texte);font-weight:600}
  .ecx-phase summary .ecx-mini{margin-left:auto}
  .ecx-sec-h2{flex-direction:row;align-items:flex-end;justify-content:space-between;max-width:none;flex-wrap:wrap;gap:16px}
  .ecx-sec-h2>div:first-child{display:flex;flex-direction:column;gap:12px}
  .ecx-filtres{display:flex;gap:6px;flex-wrap:wrap}
  .ecx-filtres button{font:inherit;font-size:12.5px;font-weight:600;height:32px;padding:0 13px;border:1px solid var(--filet);background:#fff;color:var(--encre);border-radius:16px;cursor:pointer}
  .ecx-filtres button[aria-pressed='true']{background:var(--nuit);border-color:var(--nuit);color:#fff}
  .ecx-journal{list-style:none;margin:0;padding:8px 26px}
  .ecx-journal li{display:grid;grid-template-columns:12px 120px 1fr;gap:16px;padding:16px 0;border-top:1px solid var(--filet-3)}
  .ecx-journal li:first-child{border-top:0}
  .ecx-journal li[hidden]{display:none}
  .ecx-pt{width:10px;height:10px;border-radius:50%;margin-top:6px;background:var(--c)}
  .contact{--c:#2F4F7A}.decision{--c:#8A5A12}.intervention{--c:#2D6A3E}.organisation{--c:#6B4E8A}.document{--c:#5B606A}
  .ecx-journal time{font-size:13px;color:var(--gris);padding-top:2px;white-space:nowrap}
  .ecx-journal li>div{display:flex;flex-direction:column;gap:3px}
  .ecx-type{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--c)}
  .ecx-journal b{font-size:15px;color:var(--nuit)}
  .ecx-journal p{margin:0;font-size:14.5px;line-height:1.6;color:#4A4F58}
  .ecx-plus{display:block!important;padding:14px 0!important}
  .ecx-plus a,.ecx-tab-bas a{color:var(--bleu);font-weight:600;font-size:14px}
  .ecx table{width:100%;border-collapse:collapse}
  .ecx-tab{overflow-x:auto}
  .ecx th{text-align:left;font-size:11.5px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--gris);padding:13px 18px;background:#FBF9F5;border-bottom:1px solid var(--filet-3)}
  .ecx td{padding:13px 18px;border-bottom:1px solid var(--filet-3);font-size:14.5px;vertical-align:middle}
  .ecx td b{font-weight:600;color:var(--nuit)}
  .ecx tbody tr:hover td{background:#FDFCFA}
  .ecx tfoot td{font-weight:700;background:#FBF9F5;border-bottom:0}
  .ecx tr.attente td{background:#FFFBF3}
  .ecx tr.avenir td,.ecx tr.avenir td b{color:var(--gris);font-weight:500}
  .ecx-tab-bas{padding:13px 18px}
  .ecx-dr{text-align:right}
  .ecx-doc{display:inline-flex;align-items:center;gap:8px;color:var(--gris);font-size:13px;font-weight:600}
  .ecx-bien{display:grid;grid-template-columns:.85fr 1.3fr;gap:20px;align-items:start}
  .ecx-fiche{margin:0;padding:6px 22px}
  .ecx-fiche div{display:grid;grid-template-columns:120px 1fr;gap:14px;padding:12px 0;border-top:1px solid var(--filet-3)}
  .ecx-fiche div:first-child{border-top:0}
  .ecx-fiche dt{font-size:12px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--gris);padding-top:2px}
  .ecx-fiche dd{margin:0;font-size:14.5px}
  .ecx-signature{display:flex;align-items:center;gap:14px;background:#FFFBF3;border:1px solid #E4C48F;padding:18px 22px}
  .ecx-signature>div{flex:1;display:flex;flex-direction:column;gap:6px;align-items:flex-start}
