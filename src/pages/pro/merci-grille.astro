---
import Pro from '../../layouts/Pro.astro';
import Merci from '../../components/Merci.astro';
---
<Pro title="Merci, votre demande de grille est envoyée | Fil Bleu Pro" description="Votre demande de grille tarifaire a bien été envoyée à Fil Bleu Pro." noindex onglet="tarifs">
  <Merci lbl="Demande envoyée" titre="Merci, la grille vous est envoyée sous 24 heures.">
    <p class="lead">Votre demande est bien arrivée. Nous vous envoyons la grille tarifaire complète par e-mail sous 24 heures.</p>
    <p class="p">Un bien à traiter dès maintenant ? Demandez directement un devis : réponse sous 24 heures.</p>
    <div class="merci-liens"><a class="btn" href="/pro#devis">Demander un devis</a><a class="btn2" href="/pro">Retour à Fil Bleu Pro</a></div>
  </Merci>
</Pro>
