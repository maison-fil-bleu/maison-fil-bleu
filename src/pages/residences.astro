---
/** Page partenaires : résidences seniors et EHPAD. Adresse imprimée (QR code de la plaquette) : /residences, ne pas changer. */
import PagePartenaire from '../components/PagePartenaire.astro';
import { META } from '../config/meta';
const meta = META['/residences'];
---
<PagePartenaire cle="residences" title={meta.title} description={meta.description}
  surtitre="Pour les résidences seniors et les EHPAD"
  titre="Préparation et accompagnement" titreItalique="à l'entrée en résidence."
  sousTitre="Avec le futur résident et sa famille, nous prenons tout en charge : l'organisation, le déménagement, le tri, l'installation de la chambre et l'ancien logement."
  structure="Votre résidence ou établissement" echeance="Date d'entrée prévue…" pdf="Maison-Fil-Bleu-plaquette-residences.pdf">

  <section class="sec pt-sec">
    <div class="w">
      <span class="lbl">Le cadre de travail</span>
      <h2 class="h2">Entrer en résidence, sans tout porter seul.</h2>
      <div class="pt-cadre">
        <div><h3>Avant l'entrée</h3><p class="p">Tri accompagné, à son rythme. Plan de la chambre : ce qui suit, ce qui reste. Déménagement coordonné.</p></div>
        <div><h3>Le jour de l'arrivée</h3><p class="p">Meubles placés, lit fait, photos accrochées, objets familiers à leur place dès le premier soir.</p></div>
        <div><h3>L'ancien logement</h3><p class="p">Vidé, nettoyé, démarches faites. Si la famille vend le logement, nous l'accompagnons dans le choix de l'agence, en toute neutralité, puis préparons le logement.</p></div>
        <div><h3>Des entrées à la date prévue</h3><p class="p">Planning calé sur la date d'entrée ; sous 7 jours en cas d'urgence.</p></div>
      </div>
      <h2 class="h2" style="margin-top:72px">Ce que votre établissement y gagne.</h2>
      <div class="pt-cadre">
        <div><h3>Des entrées à la date prévue</h3><p class="p">La chambre est occupée sans délai.</p></div>
        <div><h3>Des familles rassurées</h3><p class="p">Un seul interlocuteur, même à distance.</p></div>
        <div><h3>Une adaptation plus douce</h3><p class="p">Une chambre personnalisée dès le premier soir.</p></div>
        <div><h3>Un frein en moins</h3><p class="p">L'ancien logement est pris en charge : il ne retarde plus l'entrée.</p></div>
      </div>
      <div class="pt-encart">
        <h3>Dans le respect de votre cadre.</h3>
        <p class="p">Nous intervenons selon vos horaires et votre règlement intérieur, dans la tranquillité des résidents. Aucun frais pour l'établissement : le devis est établi et signé avec la famille.</p>
      </div>
      <div class="pt-encart">
        <h3>Ce que vous pouvez dire aux familles</h3>
        <ul class="pt-liste">
          <li>Un seul interlocuteur s'occupe de tout, même pour les proches éloignés.</li>
          <li>L'ancien logement est vidé et nettoyé ; aide neutre au choix de l'agence.</li>
          <li>La chambre est installée avant l'arrivée, avec ses meubles et ses photos.</li>
          <li>Rien ne part sans l'accord du futur résident.</li>
          <li>Diagnostic offert, devis forfaitaire, facilités de paiement possibles.</li>
          <li>Un suivi en ligne de chaque étape, même à distance.</li>
        </ul>
      </div>
    </div>
  </section>
</PagePartenaire>
