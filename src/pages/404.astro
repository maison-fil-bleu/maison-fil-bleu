---
import Famille from '../layouts/Famille.astro';
---
<Famille title="Page introuvable | Maison Fil Bleu" description="Cette page n'existe pas ou a été déplacée." noindex>
  <section class="sec">
    <div class="w" style="max-width:860px;display:flex;flex-direction:column;gap:26px;min-height:40vh">
      <span class="lbl">Page introuvable</span>
      <h1 class="h1">Cette page n'existe pas, ou plus.</h1>
      <p class="lead">L'adresse est peut-être incomplète, ou la page a été déplacée. Vous trouverez sans doute ce que vous cherchez à partir de l'accueil.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px"><a class="btn" href="/">Retour à l'accueil</a><a class="btn2" href="/contact">Nous contacter</a></div>
    </div>
  </section>
</Famille>
