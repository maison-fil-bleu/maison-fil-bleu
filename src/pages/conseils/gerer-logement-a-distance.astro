.box ul{margin:0}
.toc a{display:block;padding:10px 0;border-bottom:1px solid #DDD4C5;color:#18202C;text-decoration:none;font-size:15px;line-height:1.5}
.alayout{display:grid;grid-template-columns:280px minmax(0,1fr);gap:88px;align-items:start}
